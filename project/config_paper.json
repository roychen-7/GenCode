{
  "model": {
    "lookback_window": 10,
    "predict_window": 2,
    "latent_dim": 128,
    "hidden_dim": 128,
    "gamma": 2.0,
    "num_features": 1,
    "num_stocks": 1
  },
  "train": {
    "num_epochs": 100,
    "batch_size": 2,
    "learning_rate": 0.0001,
    "weight_decay": 0.0
  },
  "data": {
    "instruments": "csi300",
    "start_date": "2020-01-01",
    "end_date": "2020-06-30",
    "features": ["$close"],
    "label": "Ref($close, -1)/$close - 1"
  }
}
